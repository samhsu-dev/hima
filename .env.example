# Unified configuration — one file for both consumers:
#   - docker compose interpolates ${HIMA_*} in docker-compose.yml
#   - the hima CLI loads it at entry for its argument defaults
# Precedence: CLI flag > exported environment > .env > code default.
# Copy to .env and edit; .env is gitignored. Active values below are the
# code defaults — a copied .env pins them, so re-check after upgrades.

# Advisor inference server. Host-published port; the container-internal
# port stays 8090.
HIMA_ADVISOR_PORT=8090
# A host game posts inference to this host. A container game never reads
# it: `hima run` derives the address the job reaches the advisor on from
# the manifest and passes it into the container.
HIMA_ADVISOR_HOST=localhost
# Models the advisor serves, comma-separated Hugging Face names. Default:
# the paper's published trio SNUMPR/Terran-a,SNUMPR/Terran-b,SNUMPR/Terran-c.
#HIMA_ADVISOR_MODELS=

# Observation webui bind host and published port.
HIMA_WEBUI_HOST=127.0.0.1
HIMA_WEBUI_PORT=8123

# Deployment axis 1 — where `hima up` runs the managed services: host
# processes or the compose containers (host | container). `hima down`/
# `status` follow the manifest the last `up` recorded.
HIMA_SERVICES=host
# Whether `hima up` also starts the observation webui. A run needs an
# advisor, never a place to watch it from, so watching is opt-in.
HIMA_WEBUI=false

# Deployment axis 2 — where `hima run` runs the game: the containerized
# SC2 4.10 client, or the retail client installed on this machine
# (container | host). Independent of HIMA_SERVICES: a container game
# reaches a host advisor through the container-to-host name.
HIMA_GAME=container

# Deployment axis 3 — how a run is watched (none | web | pygui). `web`
# opens the live webui page before the game and requires `hima up --webui`;
# `pygui` opens the pysc2 renderer on the archived replay afterwards. Both
# read runs/ and tmp/, which either game placement writes.
HIMA_UI=none

# Host publish of the opt-in compose `leader` profile. Moving it requires
# pointing HIMA_LEADER_BASE_URL at the new port. hima never binds this
# port itself: the leader engine is yours to start.
HIMA_OLLAMA_PORT=11434

# Leader model served over an OpenAI-compatible endpoint.
HIMA_LEADER_MODEL=qwen3:8b
# Leader endpoint. Unset, each context uses its own default for the same
# native Ollama server — host `hima run`: http://localhost:11434/v1; game
# container: http://host.docker.internal:11434/v1. Set it only for a real
# override (a remote provider, or http://ollama:11434/v1 for the compose
# ollama service). The value must be reachable from where the game runs:
# a localhost URL here breaks containerized games.
#HIMA_LEADER_BASE_URL=
# API key sent to the leader endpoint. Ollama accepts any value; a remote
# provider needs its real key — set it in .env, never commit it.
HIMA_LEADER_API_KEY=ollama
# Remote-provider example — uncomment all three, replace the key:
#HIMA_LEADER_MODEL=gpt-4o-mini
#HIMA_LEADER_BASE_URL=https://api.openai.com/v1
#HIMA_LEADER_API_KEY=sk-replace-me

# Log level for the hima CLI, the game process, and the advisor server
# (standard logging names: DEBUG, INFO, WARNING, ERROR). Records go to
# stderr.
HIMA_LOG_LEVEL=INFO

# StarCraft II game image build: the SC2 zip's unzip password, which is
# Blizzard's AI and Machine Learning License acceptance (docker/
# game.Dockerfile). Write it once here — every later
# `hima run --game container` reads it through the config chain. No code
# default; never committed.
#SC2_LICENSE=iagreetotheeula
